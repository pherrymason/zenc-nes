import "./cpu/cpu6502.zc";
import "./cpu/address_modes.zc";
import "./cpu/instructions.zc";

impl Cpu6502 {
    fn create(memory: Memory) -> Cpu6502 {
        let cpu = Cpu6502{
            memory: memory,
            registers: Registers::create(),
            //debugger: debugger
        };

        cpu.initInstructionsTable();

        return cpu;
    }

    // Power on or Reset button: registers to their initial state and Pc to the
    // address stored at the reset vector (0xFFFC). It takes 7 cycles.
    fn reset(self) {
        self.registers.reset();
        self.registers.Pc = self.read16(self.registers.Pc);
        self.opCyclesLeft = 0;
        self.cycle = 7;
    }

    // A reset that starts at the given address instead of the one at the reset
    // vector. nestest's automated mode starts at 0xC000 this way.
    fn resetToAddress(self, address: Address) {
        self.reset();
        self.registers.Pc = address;
    }

    fn initInstructionsTable(self) {
        // Stores: A, X, Y -> M
        self.instructions[0x81] = Instruction::create("STA", AddressMode::IndirectX, Cpu6502::sta, 6, 2);
        self.instructions[0x84] = Instruction::create("STY", AddressMode::ZeroPage, Cpu6502::sty, 3, 2);
        self.instructions[0x85] = Instruction::create("STA", AddressMode::ZeroPage, Cpu6502::sta, 3, 2);
        self.instructions[0x86] = Instruction::create("STX", AddressMode::ZeroPage, Cpu6502::stx, 3, 2);
        self.instructions[0x8C] = Instruction::create("STY", AddressMode::Absolute, Cpu6502::sty, 4, 3);
        self.instructions[0x8D] = Instruction::create("STA", AddressMode::Absolute, Cpu6502::sta, 4, 3);
        self.instructions[0x8E] = Instruction::create("STX", AddressMode::Absolute, Cpu6502::stx, 4, 3);
        self.instructions[0x91] = Instruction::create("STA", AddressMode::IndirectY, Cpu6502::sta, 6, 2);
        self.instructions[0x94] = Instruction::create("STY", AddressMode::ZeroPageX, Cpu6502::sty, 4, 2);
        self.instructions[0x95] = Instruction::create("STA", AddressMode::ZeroPageX, Cpu6502::sta, 4, 2);
        self.instructions[0x96] = Instruction::create("STX", AddressMode::ZeroPageY, Cpu6502::stx, 4, 2);
        self.instructions[0x99] = Instruction::create("STA", AddressMode::AbsoluteYIndexed, Cpu6502::sta, 5, 3);
        self.instructions[0x9D] = Instruction::create("STA", AddressMode::AbsoluteXIndexed, Cpu6502::sta, 5, 3);

        // Loads: M -> A, X, Y
        self.instructions[0xA0] = Instruction::create("LDY", AddressMode::Immediate, Cpu6502::ldy, 2, 2);
        self.instructions[0xA1] = Instruction::create("LDA", AddressMode::IndirectX, Cpu6502::lda, 6, 2);
        self.instructions[0xA2] = Instruction::create("LDX", AddressMode::Immediate, Cpu6502::ldx, 2, 2);
        self.instructions[0xA4] = Instruction::create("LDY", AddressMode::ZeroPage, Cpu6502::ldy, 3, 2);
        self.instructions[0xA5] = Instruction::create("LDA", AddressMode::ZeroPage, Cpu6502::lda, 3, 2);
        self.instructions[0xA6] = Instruction::create("LDX", AddressMode::ZeroPage, Cpu6502::ldx, 3, 2);
        self.instructions[0xA9] = Instruction::create("LDA", AddressMode::Immediate, Cpu6502::lda, 2, 2);
        self.instructions[0xAC] = Instruction::create("LDY", AddressMode::Absolute, Cpu6502::ldy, 4, 3);
        self.instructions[0xAD] = Instruction::create("LDA", AddressMode::Absolute, Cpu6502::lda, 4, 3);
        self.instructions[0xAE] = Instruction::create("LDX", AddressMode::Absolute, Cpu6502::ldx, 4, 3);
        self.instructions[0xB1] = Instruction::create("LDA", AddressMode::IndirectY, Cpu6502::lda, 5, 2);
        self.instructions[0xB4] = Instruction::create("LDY", AddressMode::ZeroPageX, Cpu6502::ldy, 4, 2);
        self.instructions[0xB5] = Instruction::create("LDA", AddressMode::ZeroPageX, Cpu6502::lda, 4, 2);
        self.instructions[0xB6] = Instruction::create("LDX", AddressMode::ZeroPageY, Cpu6502::ldx, 4, 2);
        self.instructions[0xB9] = Instruction::create("LDA", AddressMode::AbsoluteYIndexed, Cpu6502::lda, 4, 3);
        self.instructions[0xBC] = Instruction::create("LDY", AddressMode::AbsoluteXIndexed, Cpu6502::ldy, 4, 3);
        self.instructions[0xBD] = Instruction::create("LDA", AddressMode::AbsoluteXIndexed, Cpu6502::lda, 4, 3);
        self.instructions[0xBE] = Instruction::create("LDX", AddressMode::AbsoluteYIndexed, Cpu6502::ldx, 4, 3);

        // Flags
        self.instructions[0x18] = Instruction::create("CLC", AddressMode::Implicit, Cpu6502::clc, 2, 1);
        self.instructions[0x38] = Instruction::create("SEC", AddressMode::Implicit, Cpu6502::sec, 2, 1);
        self.instructions[0x58] = Instruction::create("CLI", AddressMode::Implicit, Cpu6502::cli, 2, 1);
        self.instructions[0x78] = Instruction::create("SEI", AddressMode::Implicit, Cpu6502::sei, 2, 1);
        self.instructions[0xB8] = Instruction::create("CLV", AddressMode::Implicit, Cpu6502::clv, 2, 1);
        self.instructions[0xD8] = Instruction::create("CLD", AddressMode::Implicit, Cpu6502::cld, 2, 1);
        self.instructions[0xF8] = Instruction::create("SED", AddressMode::Implicit, Cpu6502::sed, 2, 1);

        // Transfers between registers
        self.instructions[0x8A] = Instruction::create("TXA", AddressMode::Implicit, Cpu6502::txa, 2, 1);
        self.instructions[0x98] = Instruction::create("TYA", AddressMode::Implicit, Cpu6502::tya, 2, 1);
        self.instructions[0x9A] = Instruction::create("TXS", AddressMode::Implicit, Cpu6502::txs, 2, 1);
        self.instructions[0xA8] = Instruction::create("TAY", AddressMode::Implicit, Cpu6502::tay, 2, 1);
        self.instructions[0xAA] = Instruction::create("TAX", AddressMode::Implicit, Cpu6502::tax, 2, 1);
        self.instructions[0xBA] = Instruction::create("TSX", AddressMode::Implicit, Cpu6502::tsx, 2, 1);

        // Increments and decrements
        self.instructions[0x88] = Instruction::create("DEY", AddressMode::Implicit, Cpu6502::dey, 2, 1);
        self.instructions[0xC6] = Instruction::create("DEC", AddressMode::ZeroPage, Cpu6502::dec, 5, 2);
        self.instructions[0xC8] = Instruction::create("INY", AddressMode::Implicit, Cpu6502::iny, 2, 1);
        self.instructions[0xCA] = Instruction::create("DEX", AddressMode::Implicit, Cpu6502::dex, 2, 1);
        self.instructions[0xCE] = Instruction::create("DEC", AddressMode::Absolute, Cpu6502::dec, 6, 3);
        self.instructions[0xD6] = Instruction::create("DEC", AddressMode::ZeroPageX, Cpu6502::dec, 6, 2);
        self.instructions[0xDE] = Instruction::create("DEC", AddressMode::AbsoluteXIndexed, Cpu6502::dec, 7, 3);
        self.instructions[0xE6] = Instruction::create("INC", AddressMode::ZeroPage, Cpu6502::inc, 5, 2);
        self.instructions[0xE8] = Instruction::create("INX", AddressMode::Implicit, Cpu6502::inx, 2, 1);
        self.instructions[0xEE] = Instruction::create("INC", AddressMode::Absolute, Cpu6502::inc, 6, 3);
        self.instructions[0xF6] = Instruction::create("INC", AddressMode::ZeroPageX, Cpu6502::inc, 6, 2);
        self.instructions[0xFE] = Instruction::create("INC", AddressMode::AbsoluteXIndexed, Cpu6502::inc, 7, 3);

        // Logic: A with M
        self.instructions[0x01] = Instruction::create("ORA", AddressMode::IndirectX, Cpu6502::ora, 6, 2);
        self.instructions[0x05] = Instruction::create("ORA", AddressMode::ZeroPage, Cpu6502::ora, 3, 2);
        self.instructions[0x09] = Instruction::create("ORA", AddressMode::Immediate, Cpu6502::ora, 2, 2);
        self.instructions[0x0D] = Instruction::create("ORA", AddressMode::Absolute, Cpu6502::ora, 4, 3);
        self.instructions[0x11] = Instruction::create("ORA", AddressMode::IndirectY, Cpu6502::ora, 5, 2);
        self.instructions[0x15] = Instruction::create("ORA", AddressMode::ZeroPageX, Cpu6502::ora, 4, 2);
        self.instructions[0x19] = Instruction::create("ORA", AddressMode::AbsoluteYIndexed, Cpu6502::ora, 4, 3);
        self.instructions[0x1D] = Instruction::create("ORA", AddressMode::AbsoluteXIndexed, Cpu6502::ora, 4, 3);
        self.instructions[0x21] = Instruction::create("AND", AddressMode::IndirectX, Cpu6502::and_, 6, 2);
        self.instructions[0x24] = Instruction::create("BIT", AddressMode::ZeroPage, Cpu6502::bit, 3, 2);
        self.instructions[0x25] = Instruction::create("AND", AddressMode::ZeroPage, Cpu6502::and_, 3, 2);
        self.instructions[0x29] = Instruction::create("AND", AddressMode::Immediate, Cpu6502::and_, 2, 2);
        self.instructions[0x2C] = Instruction::create("BIT", AddressMode::Absolute, Cpu6502::bit, 4, 3);
        self.instructions[0x2D] = Instruction::create("AND", AddressMode::Absolute, Cpu6502::and_, 4, 3);
        self.instructions[0x31] = Instruction::create("AND", AddressMode::IndirectY, Cpu6502::and_, 5, 2);
        self.instructions[0x35] = Instruction::create("AND", AddressMode::ZeroPageX, Cpu6502::and_, 4, 2);
        self.instructions[0x39] = Instruction::create("AND", AddressMode::AbsoluteYIndexed, Cpu6502::and_, 4, 3);
        self.instructions[0x3D] = Instruction::create("AND", AddressMode::AbsoluteXIndexed, Cpu6502::and_, 4, 3);
        self.instructions[0x41] = Instruction::create("EOR", AddressMode::IndirectX, Cpu6502::eor, 6, 2);
        self.instructions[0x45] = Instruction::create("EOR", AddressMode::ZeroPage, Cpu6502::eor, 3, 2);
        self.instructions[0x49] = Instruction::create("EOR", AddressMode::Immediate, Cpu6502::eor, 2, 2);
        self.instructions[0x4D] = Instruction::create("EOR", AddressMode::Absolute, Cpu6502::eor, 4, 3);
        self.instructions[0x51] = Instruction::create("EOR", AddressMode::IndirectY, Cpu6502::eor, 5, 2);
        self.instructions[0x55] = Instruction::create("EOR", AddressMode::ZeroPageX, Cpu6502::eor, 4, 2);
        self.instructions[0x59] = Instruction::create("EOR", AddressMode::AbsoluteYIndexed, Cpu6502::eor, 4, 3);
        self.instructions[0x5D] = Instruction::create("EOR", AddressMode::AbsoluteXIndexed, Cpu6502::eor, 4, 3);

        // Stack
        self.instructions[0x08] = Instruction::create("PHP", AddressMode::Implicit, Cpu6502::php, 3, 1);
        self.instructions[0x28] = Instruction::create("PLP", AddressMode::Implicit, Cpu6502::plp, 4, 1);
        self.instructions[0x48] = Instruction::create("PHA", AddressMode::Implicit, Cpu6502::pha, 3, 1);
        self.instructions[0x68] = Instruction::create("PLA", AddressMode::Implicit, Cpu6502::pla, 4, 1);

        // Comparisons
        self.instructions[0xC0] = Instruction::create("CPY", AddressMode::Immediate, Cpu6502::cpy, 2, 2);
        self.instructions[0xC1] = Instruction::create("CMP", AddressMode::IndirectX, Cpu6502::cmp, 6, 2);
        self.instructions[0xC4] = Instruction::create("CPY", AddressMode::ZeroPage, Cpu6502::cpy, 3, 2);
        self.instructions[0xC5] = Instruction::create("CMP", AddressMode::ZeroPage, Cpu6502::cmp, 3, 2);
        self.instructions[0xC9] = Instruction::create("CMP", AddressMode::Immediate, Cpu6502::cmp, 2, 2);
        self.instructions[0xCC] = Instruction::create("CPY", AddressMode::Absolute, Cpu6502::cpy, 4, 3);
        self.instructions[0xCD] = Instruction::create("CMP", AddressMode::Absolute, Cpu6502::cmp, 4, 3);
        self.instructions[0xD1] = Instruction::create("CMP", AddressMode::IndirectY, Cpu6502::cmp, 5, 2);
        self.instructions[0xD5] = Instruction::create("CMP", AddressMode::ZeroPageX, Cpu6502::cmp, 4, 2);
        self.instructions[0xD9] = Instruction::create("CMP", AddressMode::AbsoluteYIndexed, Cpu6502::cmp, 4, 3);
        self.instructions[0xDD] = Instruction::create("CMP", AddressMode::AbsoluteXIndexed, Cpu6502::cmp, 4, 3);
        self.instructions[0xE0] = Instruction::create("CPX", AddressMode::Immediate, Cpu6502::cpx, 2, 2);
        self.instructions[0xE4] = Instruction::create("CPX", AddressMode::ZeroPage, Cpu6502::cpx, 3, 2);
        self.instructions[0xEC] = Instruction::create("CPX", AddressMode::Absolute, Cpu6502::cpx, 4, 3);

        // Shifts and rotations (the Implicit ones work on A)
        self.instructions[0x06] = Instruction::create("ASL", AddressMode::ZeroPage, Cpu6502::asl, 5, 2);
        self.instructions[0x0A] = Instruction::create("ASL", AddressMode::Implicit, Cpu6502::asl, 2, 1);
        self.instructions[0x0E] = Instruction::create("ASL", AddressMode::Absolute, Cpu6502::asl, 6, 3);
        self.instructions[0x16] = Instruction::create("ASL", AddressMode::ZeroPageX, Cpu6502::asl, 6, 2);
        self.instructions[0x1E] = Instruction::create("ASL", AddressMode::AbsoluteXIndexed, Cpu6502::asl, 7, 3);
        self.instructions[0x26] = Instruction::create("ROL", AddressMode::ZeroPage, Cpu6502::rol, 5, 2);
        self.instructions[0x2A] = Instruction::create("ROL", AddressMode::Implicit, Cpu6502::rol, 2, 1);
        self.instructions[0x2E] = Instruction::create("ROL", AddressMode::Absolute, Cpu6502::rol, 6, 3);
        self.instructions[0x36] = Instruction::create("ROL", AddressMode::ZeroPageX, Cpu6502::rol, 6, 2);
        self.instructions[0x3E] = Instruction::create("ROL", AddressMode::AbsoluteXIndexed, Cpu6502::rol, 7, 3);
        self.instructions[0x46] = Instruction::create("LSR", AddressMode::ZeroPage, Cpu6502::lsr, 5, 2);
        self.instructions[0x4A] = Instruction::create("LSR", AddressMode::Implicit, Cpu6502::lsr, 2, 1);
        self.instructions[0x4E] = Instruction::create("LSR", AddressMode::Absolute, Cpu6502::lsr, 6, 3);
        self.instructions[0x56] = Instruction::create("LSR", AddressMode::ZeroPageX, Cpu6502::lsr, 6, 2);
        self.instructions[0x5E] = Instruction::create("LSR", AddressMode::AbsoluteXIndexed, Cpu6502::lsr, 7, 3);
        self.instructions[0x66] = Instruction::create("ROR", AddressMode::ZeroPage, Cpu6502::ror, 5, 2);
        self.instructions[0x6A] = Instruction::create("ROR", AddressMode::Implicit, Cpu6502::ror, 2, 1);
        self.instructions[0x6E] = Instruction::create("ROR", AddressMode::Absolute, Cpu6502::ror, 6, 3);
        self.instructions[0x76] = Instruction::create("ROR", AddressMode::ZeroPageX, Cpu6502::ror, 6, 2);
        self.instructions[0x7E] = Instruction::create("ROR", AddressMode::AbsoluteXIndexed, Cpu6502::ror, 7, 3);

        // Branches
        self.instructions[0x10] = Instruction::create("BPL", AddressMode::Relative, Cpu6502::bpl, 2, 2);
        self.instructions[0x30] = Instruction::create("BMI", AddressMode::Relative, Cpu6502::bmi, 2, 2);
        self.instructions[0x50] = Instruction::create("BVC", AddressMode::Relative, Cpu6502::bvc, 2, 2);
        self.instructions[0x70] = Instruction::create("BVS", AddressMode::Relative, Cpu6502::bvs, 2, 2);
        self.instructions[0x90] = Instruction::create("BCC", AddressMode::Relative, Cpu6502::bcc, 2, 2);
        self.instructions[0xB0] = Instruction::create("BCS", AddressMode::Relative, Cpu6502::bcs, 2, 2);
        self.instructions[0xD0] = Instruction::create("BNE", AddressMode::Relative, Cpu6502::bne, 2, 2);
        self.instructions[0xF0] = Instruction::create("BEQ", AddressMode::Relative, Cpu6502::beq, 2, 2);

        // Jumps, subroutines and interrupts
        self.instructions[0x00] = Instruction::create("BRK", AddressMode::Implicit, Cpu6502::brk, 7, 1);
        self.instructions[0x20] = Instruction::create("JSR", AddressMode::Absolute, Cpu6502::jsr, 6, 3);
        self.instructions[0x40] = Instruction::create("RTI", AddressMode::Implicit, Cpu6502::rti, 6, 1);
        self.instructions[0x4C] = Instruction::create("JMP", AddressMode::Absolute, Cpu6502::jmp, 3, 3);
        self.instructions[0x60] = Instruction::create("RTS", AddressMode::Implicit, Cpu6502::rts, 6, 1);
        self.instructions[0x6C] = Instruction::create("JMP", AddressMode::Indirect, Cpu6502::jmp, 5, 3);
        self.instructions[0xEA] = Instruction::create("NOP", AddressMode::Implicit, Cpu6502::nop, 2, 1);

        // Arithmetic
        self.instructions[0x61] = Instruction::create("ADC", AddressMode::IndirectX, Cpu6502::adc, 6, 2);
        self.instructions[0x65] = Instruction::create("ADC", AddressMode::ZeroPage, Cpu6502::adc, 3, 2);
        self.instructions[0x69] = Instruction::create("ADC", AddressMode::Immediate, Cpu6502::adc, 2, 2);
        self.instructions[0x6D] = Instruction::create("ADC", AddressMode::Absolute, Cpu6502::adc, 4, 3);
        self.instructions[0x71] = Instruction::create("ADC", AddressMode::IndirectY, Cpu6502::adc, 5, 2);
        self.instructions[0x75] = Instruction::create("ADC", AddressMode::ZeroPageX, Cpu6502::adc, 4, 2);
        self.instructions[0x79] = Instruction::create("ADC", AddressMode::AbsoluteYIndexed, Cpu6502::adc, 4, 3);
        self.instructions[0x7D] = Instruction::create("ADC", AddressMode::AbsoluteXIndexed, Cpu6502::adc, 4, 3);
        self.instructions[0xE1] = Instruction::create("SBC", AddressMode::IndirectX, Cpu6502::sbc, 6, 2);
        self.instructions[0xE5] = Instruction::create("SBC", AddressMode::ZeroPage, Cpu6502::sbc, 3, 2);
        self.instructions[0xE9] = Instruction::create("SBC", AddressMode::Immediate, Cpu6502::sbc, 2, 2);
        self.instructions[0xED] = Instruction::create("SBC", AddressMode::Absolute, Cpu6502::sbc, 4, 3);
        self.instructions[0xF1] = Instruction::create("SBC", AddressMode::IndirectY, Cpu6502::sbc, 5, 2);
        self.instructions[0xF5] = Instruction::create("SBC", AddressMode::ZeroPageX, Cpu6502::sbc, 4, 2);
        self.instructions[0xF9] = Instruction::create("SBC", AddressMode::AbsoluteYIndexed, Cpu6502::sbc, 4, 3);
        self.instructions[0xFD] = Instruction::create("SBC", AddressMode::AbsoluteXIndexed, Cpu6502::sbc, 4, 3);
    }

    fn runNextInstruction(self) {
        let pc: Address = self.registers.Pc;
        let opcode: byte = self.memory.read(pc);
        let instruction = self.instructions[opcode];

        if (instruction.method == NULL) {
            panic(f"opcode 0x{opcode:02X} at 0x{pc:04X} is not an official 6502 instruction");
        }

        // The operand bytes follow the opcode
        let evaluated = self.evaluateOperandAddress(instruction.addressMode, pc + 1);

        // Pc moves on before the instruction runs: branches and JSR count on it
        self.registers.Pc += (Address)instruction.size;

        // Before the call: branches add their cycles to it
        self.opCyclesLeft = instruction.cycles;
        let mayTakeExtraCycle: bool = instruction.method(self, OperationMethodArgument {
            addressMode: instruction.addressMode,
            operandAddress: evaluated.address,
        });

        if (evaluated.pageCrossed && mayTakeExtraCycle) {
            self.opCyclesLeft += 1;
        }

        self.cycle += (u32)self.opCyclesLeft;
    }

    // One CPU cycle. The whole instruction runs on its first cycle;
    // the following ones only count down until the next one can start
    fn tick(self) {
        if (self.opCyclesLeft == 0) {
            if (self.nmiPending) {
                // Between instructions, as the 6502 does; it takes 7 cycles
                self.nmiPending = false;
                self.nmi();
                self.opCyclesLeft = 7;
                self.cycle += 7;
            } else {
                self.runNextInstruction();
            }
        }
        self.opCyclesLeft -= 1;
    }
}