import "./support/simple_memory.zc";
import "../src/nes/cpu.zc";

// The operand bytes are the raw bytes of the instruction after its opcode, as
// they are in memory: the CPU log prints them next to the opcode.
fn operandBytesAre(result: EvaluatedAddress*, first: byte, second: byte = 0) -> bool {
    return result.opcodeOperand[0] == first
        && result.opcodeOperand[1] == second
        && result.opcodeOperand[2] == 0;
}

test "immediate: the operand is at pc" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x100;
    cpu.memory.write(0x100, 0x42);  // the constant

    let result = cpu.evalImmediate(cpu.registers.Pc);

    assert(result.address == 0x100, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0x42), "operand bytes");
}

test "zero page: the operand is the address" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x00;
    cpu.memory.write(0x00, 0x40);

    let result = cpu.evalZeroPage(cpu.registers.Pc);

    assert(result.address == 0x40, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0x40), "operand bytes");
}

test "zero page X: adds X to the operand" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x00;
    cpu.memory.write(0x00, 0x05);
    cpu.registers.X = 0x10;

    let result = cpu.evalZeroPageX(cpu.registers.Pc);

    assert(result.address == 0x15, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0x05), "operand bytes");
}

test "zero page X: wraps around inside page zero" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.X = 0x10;
    cpu.registers.Pc = 0x00;
    cpu.memory.write(cpu.registers.Pc, 0xF0);

    let result = cpu.evalZeroPageX(cpu.registers.Pc);

    assert(result.address == 0x00, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0xF0), "operand bytes");
}

test "zero page Y: wraps around inside page zero" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Y = 0x10;
    cpu.registers.Pc = 0x00;
    cpu.memory.write(cpu.registers.Pc, 0xF0);

    let result = cpu.evalZeroPageY(cpu.registers.Pc);

    assert(result.address == 0x00, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0xF0), "operand bytes");
}

test "absolute: the two operand bytes are the address" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x00;
    cpu.memory.write(0x0000, 0x30);
    cpu.memory.write(0x0001, 0x01);

    let result = cpu.evalAbsolute(cpu.registers.Pc);

    assert(result.address == 0x0130, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0x30, 0x01), "operand bytes");
}

test "absolute X: page not crossed" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.X = 5;
    cpu.registers.Pc = 0x00;
    cpu.memory.write(0x0000, 0x01);
    cpu.memory.write(0x0001, 0x01);

    let result = cpu.evalAbsoluteXIndexed(cpu.registers.Pc);

    assert(result.address == 0x106, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0x01, 0x01), "operand bytes");
}

test "absolute X: page crossed" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.X = 5;
    cpu.registers.Pc = 0x00;
    cpu.memory.write(0x0000, 0xFF);
    cpu.memory.write(0x0001, 0x00);

    let result = cpu.evalAbsoluteXIndexed(cpu.registers.Pc);

    assert(result.address == 0x104, "address");
    assert(result.pageCrossed, "page crossed");
    assert(operandBytesAre(&result, 0xFF, 0x00), "operand bytes");
}

test "absolute Y: page not crossed" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Y = 5;
    cpu.registers.Pc = 0x00;
    cpu.memory.write(0x0000, 0x01);
    cpu.memory.write(0x0001, 0x01);

    let result = cpu.evalAbsoluteYIndexed(cpu.registers.Pc);

    assert(result.address == 0x106, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0x01, 0x01), "operand bytes");
}

test "absolute Y: page crossed" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Y = 5;
    cpu.registers.Pc = 0x00;
    cpu.memory.write(0x0000, 0xFF);
    cpu.memory.write(0x0001, 0x00);

    let result = cpu.evalAbsoluteYIndexed(cpu.registers.Pc);

    assert(result.address == 0x104, "address");
    assert(result.pageCrossed, "page crossed");
    assert(operandBytesAre(&result, 0xFF, 0x00), "operand bytes");
}

test "indirect: reads the address from the pointer" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x10;
    cpu.memory.write(0x10, 0x34);   // pointer 0x0134
    cpu.memory.write(0x11, 0x01);
    cpu.memory.write(0x0134, 0x00); // address 0x0200
    cpu.memory.write(0x0135, 0x02);

    let result = cpu.evalIndirect(cpu.registers.Pc);

    assert(result.address == 0x0200, "address");
    assert(operandBytesAre(&result, 0x34, 0x01), "operand bytes");
}

test "indirect: pointer at a page end reads its high byte from the same page" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x10;
    cpu.memory.write(0x10, 0xFF);   // pointer 0x00FF
    cpu.memory.write(0x11, 0x00);
    cpu.memory.write(0x00FF, 0x55); // low byte
    cpu.memory.write(0x0000, 0x01); // high byte, read by the 6502 bug
    cpu.memory.write(0x0100, 0x02); // high byte without the bug

    let result = cpu.evalIndirect(cpu.registers.Pc);

    assert(result.address == 0x0155, "address");
    assert(operandBytesAre(&result, 0xFF, 0x00), "operand bytes");
}

test "indexed indirect: X selects the pointer in page zero" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x00;
    cpu.registers.X = 4;
    cpu.memory.write(0x00, 0x10);   // operand
    cpu.memory.write(0x14, 0x25);   // pointer at 0x10 + 4
    cpu.memory.write(0x15, 0x10);

    let result = cpu.evalIndirectX(cpu.registers.Pc);

    assert(result.address == 0x1025, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0x10), "operand bytes");
}

test "indexed indirect: operand plus X wraps inside page zero" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x50;
    cpu.registers.X = 4;
    cpu.memory.write(0x50, 0xFE);   // operand: 0xFE + 4 = 0x02
    cpu.memory.write(0x02, 0x34);   // pointer at 0x02
    cpu.memory.write(0x03, 0x12);
    cpu.memory.write(0x102, 0x99);  // pointer without the wrap
    cpu.memory.write(0x103, 0x99);

    let result = cpu.evalIndirectX(cpu.registers.Pc);

    assert(result.address == 0x1234, "address");
    assert(operandBytesAre(&result, 0xFE), "operand bytes");
}

test "indexed indirect: pointer at 0xFF wraps to 0x00 for its high byte" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x50;
    cpu.registers.X = 1;
    cpu.memory.write(0x50, 0xFE);   // operand: 0xFE + 1 = 0xFF
    cpu.memory.write(0xFF, 0x10);   // low byte
    cpu.memory.write(0x00, 0x05);   // high byte, after the wrap
    cpu.memory.write(0x100, 0x09);  // high byte without the wrap

    let result = cpu.evalIndirectX(cpu.registers.Pc);

    assert(result.address == 0x0510, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0xFE), "operand bytes");
}

test "indirect indexed: adds Y to the pointer, page not crossed" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x50;
    cpu.registers.Y = 0x10;
    cpu.memory.write(0x50, 0x86);   // operand
    cpu.memory.write(0x86, 0x28);   // pointer 0x4028
    cpu.memory.write(0x87, 0x40);

    let result = cpu.evalIndirectY(cpu.registers.Pc);

    assert(result.address == 0x4038, "address");
    assert(!result.pageCrossed, "page not crossed");
    assert(operandBytesAre(&result, 0x86), "operand bytes");
}

test "indirect indexed: pointer at 0xFF wraps, page crossed" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x50;
    cpu.registers.Y = 0xFF;
    cpu.memory.write(0x50, 0xFF);   // operand
    cpu.memory.write(0xFF, 0x46);   // low byte of pointer 0x0146
    cpu.memory.write(0x00, 0x01);   // high byte, after the wrap
    cpu.memory.write(0x100, 0x09);  // high byte without the wrap

    let result = cpu.evalIndirectY(cpu.registers.Pc);

    assert(result.address == 0x0245, "address");
    assert(result.pageCrossed, "page crossed");
    assert(operandBytesAre(&result, 0xFF), "operand bytes");
}

test "relative: positive offset jumps forward from the next instruction" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x10;
    cpu.memory.write(0x10, 0x04);   // +4

    let result = cpu.evalRelative(cpu.registers.Pc);

    assert(result.address == 0x15, "address");
    assert(operandBytesAre(&result, 0x04), "operand bytes");
}

test "relative: negative offset jumps backwards from the next instruction" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x10;
    cpu.memory.write(0x10, 0xFC);   // -4

    let result = cpu.evalRelative(cpu.registers.Pc);

    assert(result.address == 0x0D, "address");
    assert(operandBytesAre(&result, 0xFC), "operand bytes");
}

test "relative: 0x7F is the largest forward offset" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x200;
    cpu.memory.write(0x200, 0x7F);  // +127

    let result = cpu.evalRelative(cpu.registers.Pc);

    assert(result.address == 0x280, "address");
}

test "relative: 0x80 is the largest backward offset" {
    let mem = SimpleMemory{};
    let cpu = Cpu6502::create(&mem);
    cpu.registers.Pc = 0x200;
    cpu.memory.write(0x200, 0x80);  // -128

    let result = cpu.evalRelative(cpu.registers.Pc);

    assert(result.address == 0x181, "address");
}
